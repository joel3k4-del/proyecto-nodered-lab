[
    {
        "id": "tab_ej1",
        "type": "tab",
        "label": "Clase 4 - Ejercicio 1",
        "disabled": false,
        "info": "Sensor simulado: temperatura, humedad y alarmas."
    },
    {
        "id": "inj",
        "type": "inject",
        "z": "tab_ej1",
        "name": "Click: generar dato",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 160,
        "wires": [
            [
                "rnd"
            ]
        ]
    },
    {
        "id": "rnd",
        "type": "random",
        "z": "tab_ej1",
        "name": "Random 0-40",
        "low": 0,
        "high": 40,
        "inte": "false",
        "property": "payload",
        "x": 340,
        "y": 160,
        "wires": [
            [
                "dbg_raw",
                "f_temp",
                "f_hum"
            ]
        ]
    },
    {
        "id": "dbg_raw",
        "type": "debug",
        "z": "tab_ej1",
        "name": "Dato aleatorio",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 570,
        "y": 60,
        "wires": []
    },
    {
        "id": "f_temp",
        "type": "function",
        "z": "tab_ej1",
        "name": "Temperatura (x10)",
        "func": "msg.payload = msg.payload * 10;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 160,
        "wires": [
            [
                "dbg_temp",
                "sw_temp"
            ]
        ]
    },
    {
        "id": "dbg_temp",
        "type": "debug",
        "z": "tab_ej1",
        "name": "Temperatura",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 810,
        "y": 120,
        "wires": []
    },
    {
        "id": "sw_temp",
        "type": "switch",
        "z": "tab_ej1",
        "name": "Temp > 50",
        "property": "payload",
        "propertyType": "msg",
        "rules": [
            {
                "t": "gt",
                "v": "50",
                "vt": "num"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 1,
        "x": 800,
        "y": 200,
        "wires": [
            [
                "ch_temp"
            ]
        ]
    },
    {
        "id": "ch_temp",
        "type": "change",
        "z": "tab_ej1",
        "name": "Texto alarma temp",
        "rules": [
            {
                "t": "set",
                "p": "payload",
                "pt": "msg",
                "to": "Alarma mayor a 50",
                "tot": "str"
            }
        ],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 1000,
        "y": 200,
        "wires": [
            [
                "dbg_al_temp"
            ]
        ]
    },
    {
        "id": "dbg_al_temp",
        "type": "debug",
        "z": "tab_ej1",
        "name": "Alarma temperatura",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 1220,
        "y": 200,
        "wires": []
    },
    {
        "id": "f_hum",
        "type": "function",
        "z": "tab_ej1",
        "name": "Humedad (x3 + 2.5)",
        "func": "msg.payload = msg.payload * 3 + 2.5;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 300,
        "wires": [
            [
                "dbg_hum",
                "sw_hum"
            ]
        ]
    },
    {
        "id": "dbg_hum",
